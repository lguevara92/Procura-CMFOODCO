NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Opcional (Fase 2): sin esto, las notificaciones por correo se omiten (solo se registran en consola).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Procura <onboarding@resend.dev>

# Opcional (Fase 3): sin esto, el botón "Extraer artículos con IA" muestra un error.
# Se obtiene en console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=

# Opcional (Fase 5): sin esto, agregar/actualizar rastreo de guías no funciona.
# Se obtiene en trackingmore.com -> API.
TRACKINGMORE_API_KEY=
# Cualquier cadena aleatoria larga; se usa en la URL del webhook que se configura
# en el dashboard de TrackingMore para protegerlo de llamadas no autorizadas.
TRACKINGMORE_WEBHOOK_SECRET=

# Necesaria para que el webhook de TrackingMore (que no tiene sesión de usuario)
# pueda escribir en la tabla tracking saltándose RLS.
# Se obtiene en Supabase -> Project Settings -> API Keys -> service_role (secreta, NUNCA exponerla al navegador).
SUPABASE_SERVICE_ROLE_KEY=
